{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "risk", "findings"],
  "properties": {
    "summary": {
      "type": "string"
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "action", "file", "description", "recommendation"],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "action": {
            "type": "string",
            "enum": ["auto-fix", "ask-user", "no-op"]
          },
          "file": {
            "type": ["string", "null"]
          },
          "line": {
            "type": ["integer", "null"]
          },
          "description": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "detail"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["fixed", "deferred", "dismissed"]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}

